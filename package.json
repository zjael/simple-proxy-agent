{
  "name": "simple-proxy-agent",
  "version": "1.1.0",
  "description": "An simple agent for HTTP and HTTPS through HTTP and SOCKS proxies",
  "main": "./src/agent.js",
  "types": "./src/agent.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "mocha --timeout 10000 --exit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjael/simple-proxy-agent.git"
  },
  "dependencies": {
    "lru-cache": "^11.2.2",
    "socks": "^2.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.9.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "mocha": "^11.0.1",
    "node-fetch": "^2.7.0",
    "pem": "^1.14.8",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "proxy",
    "agent",
    "http",
    "https",
    "socks",
    "socks4",
    "socks5",
    "tunnel",
    "connect",
    "typescript"
  ],
  "author": "Jakob Sjælland",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zjael/simple-proxy-agent/issues"
  },
  "homepage": "https://github.com/zjael/simple-proxy-agent#readme"
}
